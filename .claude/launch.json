{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "SPORTS_FOLLOW_MAIL_LOG=1",
        ".venv/bin/uvicorn",
        "sports_follow.server:app",
        "--port",
        "8421",
        "--reload",
        "--reload-dir",
        "sports_follow",
        "--timeout-graceful-shutdown",
        "3"
      ],
      "port": 8421
    },
    {
      "name": "web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd web && PATH=$HOME/.local/node/bin:$PATH npm run dev -- --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
