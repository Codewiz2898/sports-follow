<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- SPIKE ONLY. Everything here is what a Play upload would have to declare (and justify) for a recorder:
       never in a build that ships before the recorder is decided. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The floating save button over the game ("Display over other apps", granted in Settings). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <application>
    <service
      android:name="io.stann.recorder.ReplayService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection|microphone" />
  </application>
</manifest>
