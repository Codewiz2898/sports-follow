# Settings for the public build. Nothing secret: secrets live in $SECRETS_DIR on the server
# (default /etc/sports-follow), written by push-secrets.sh. See deploy/README.md.

# Licensed sources only: ESPN's unofficial endpoints are for development. Add pandascore_esports once
# PandaScore confirms in writing that the free plan allows a commercial app, and liquipedia_esports once
# there's a commercial Liquipedia plan: its free key is for non-commercial projects (BACKLOG.md, item 8).
# pubg_esports may be added once you decide to: PUBG's API terms allow commercial apps (ads, subscriptions).
# OpenDota (Dota 2 inside the map) is community-run with no data licence: off until its terms are checked.
SPORTS_FOLLOW_OPENDOTA=0
SPORTS_FOLLOW_SOURCES=sportmonks_football,sportmonks_cricket,lichess_chess
# Every sport runs; list some ("football,cricket,chess") to turn the rest off.
SPORTS_FOLLOW_SPORTS=
# No AI live checks: sports without a licensed source get pages without live scores.
SPORTS_FOLLOW_AGENT_LIVE=0
# Log lines as JSON on stdout, for whatever collects the containers' logs (Docker's today).
SPORTS_FOLLOW_LOG_FORMAT=json
# Traces and log lines (OpenTelemetry) go where otlp.env says, the secrets' file with the address and its
# key (README.md, "Traces and logs"); without it they stay here. Keep a share of traces once there are many.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2

# Accounts: sign-in codes come from this address, through Resend (its key: push-secrets.sh, resend-key).
# The domain must be verified in Resend. Without both, email sign-in is off.
# SPORTS_FOLLOW_MAIL_FROM=Sports Follow <signin@your-domain>
# Continue with Google: the OAuth web client's id (its secret: push-secrets.sh, google-client-secret).
# Its redirect URI is https://<DOMAIN>/api/auth/google/callback. Without both, the button is hidden.
# SPORTS_FOLLOW_GOOGLE_CLIENT_ID=
# Where fans write about their data: the privacy page shows it, and data sources see it in the user
# agent beside the site's address. Set it before launch: without it the privacy page has no contact.
# SPORTS_FOLLOW_CONTACT_EMAIL=

# The Android app (Trusted Web Activity), once its signing key exists: package name and the key's
# SHA-256 fingerprint, published at /.well-known/assetlinks.json for full-screen.
# SPORTS_FOLLOW_ANDROID_PACKAGE=
# SPORTS_FOLLOW_ANDROID_CERT_SHA256=
