# Settings for the public build. Nothing secret: secrets live in $SECRETS_DIR on the server
# (default /etc/sports-follow), written by push-secrets.sh. See deploy/README.md.

# Licensed sources, plus OpenDota by choice (below): ESPN's unofficial endpoints are for development. Esports runs on PandaScore's free
# plan (team titles) and PUBG's API (PUBG PC), each with its token in the secrets (push-secrets.sh). PUBG's
# terms allow commercial apps (ads, subscriptions); PandaScore was turned on (15 Oct 2026) before it confirmed
# in writing that the free plan allows a commercial app (BHA-30). Add liquipedia_esports once there's a
# commercial Liquipedia plan: its free key is for non-commercial projects (BACKLOG.md, item 8).
# OpenDota (Dota 2 inside the map) is community-run with no data licence; Bharath turned it on for the
# public build on 20 Oct 2026 (BHA-208), credited on the Credits page. SPORTS_FOLLOW_OPENDOTA=0 turns it off.
# YouTube (the feed's videos, through its Data API) runs once its key is in the secrets (youtube-key).
SPORTS_FOLLOW_SOURCES=sportmonks_football,sportmonks_cricket,lichess_chess,pandascore_esports,pubg_esports,youtube
# Every sport runs; list some ("football,cricket,chess") to turn the rest off.
SPORTS_FOLLOW_SPORTS=
# No AI live checks: sports without a licensed source get pages without live scores.
SPORTS_FOLLOW_AGENT_LIVE=0
# The research agent needs the gateway's OpenRouter key. It writes the background of a player with a live
# source and no English Wikipedia article, once a month; profiles otherwise come from Wikidata and Wikipedia.
# Without a key, turn it off: pages (scores, games, stats, live and alerts, profiles) come from the sources,
# Wikidata and Wikipedia alone.
# SPORTS_FOLLOW_AGENT=0
# Pages for players no live source has, written whole by the agent and offered as "AI research". Off by
# default (21 Oct): those players can't be followed and search doesn't list them. "1" brings them back.
# SPORTS_FOLLOW_RESEARCH=1
# Log lines as JSON on stdout, for whatever collects the containers' logs (Docker's today).
SPORTS_FOLLOW_LOG_FORMAT=json
# Traces and log lines (OpenTelemetry) go where otlp.env says, the secrets' file with the address and its
# key (README.md, "Traces and logs"); without it they stay here. Keep a share of traces once there are many.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2

# Accounts: sign-in codes come from this address, through Resend (its key: push-secrets.sh, resend-key),
# as "<app name> <address>". The address's domain must be verified in Resend (stann.in is). Without
# either the key or the address, email sign-in is off. At most SPORTS_FOLLOW_MAIL_CODES_PER_DAY codes a
# day (default 100, Resend's free plan): raise it with the plan.
SPORTS_FOLLOW_MAIL_FROM=signin@stann.in
# Continue with Google: the OAuth web client's id (its secret: push-secrets.sh, google-client-secret).
# Its redirect URI is https://<DOMAIN>/api/auth/google/callback. Without both, the button is hidden.
# SPORTS_FOLLOW_GOOGLE_CLIENT_ID=
# Where fans write about their data: the privacy page shows it, and data sources see it in the user
# agent beside the site's address. Without it the privacy page has no contact.
SPORTS_FOLLOW_CONTACT_EMAIL=bharath@stann.in

# The Android app, once its signing keys exist (BHA-25): its package and the SHA-256 fingerprints of the
# upload key and Play App Signing's (comma separated), published at /.well-known/assetlinks.json so that
# stann.in links open the app (README.md, "Android app").
# SPORTS_FOLLOW_ANDROID_PACKAGE=io.stann.app
# SPORTS_FOLLOW_ANDROID_CERT_SHA256=
