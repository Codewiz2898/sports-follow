# Read by the alloy service after the package's /etc/default/alloy (systemd/alloy.service.d/sports-follow.conf):
# this repo's config, the UI on localhost only, and no usage reports to Grafana.
CONFIG_FILE=/opt/sports-follow/deploy/alloy/config.alloy
CUSTOM_ARGS=--server.http.listen-addr=127.0.0.1:12345 --disable-reporting
