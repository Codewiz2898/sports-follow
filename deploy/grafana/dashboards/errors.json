{
  "uid": "sports-follow-errors",
  "title": "Sports Follow · Errors",
  "description": "What failed in the API, the worker and the web app, grouped by what and where, with stacks (logs.py, web_errors.py).",
  "tags": [
    "sports-follow"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Sports Follow",
      "type": "dashboards",
      "tags": [
        "sports-follow"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(?!.*(alert-state-history|usage)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Errors",
      "description": "Lines with an exception (or the web app's error) in the range: one a failure, each with its stack.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | service_name=\"sports-follow-api\" | scope_name!=\"sports_follow.web\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Worker",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | service_name=\"sports-follow-worker\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Web app",
      "description": "Errors fans' browsers sent (web/src/errors.ts), a few an hour each at most.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | scope_name=\"sports_follow.web\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Errors, grouped by what failed and where",
      "description": "One row for each kind of error: its class (or HTTP status, for the web app's failed calls) and where it was thrown, in this app's code (module:function) or the web app's source (file). First and last seen are within the range: widen it to look further back. The lines below show each one's stack; expand one to open its trace.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (from, error, place) (count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | label_format from=`{{ if eq .scope_name \"sports_follow.web\" }}web app{{ else }}{{ trimPrefix \"sports-follow-\" .service_name }}{{ end }}` [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "min_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | label_format from=`{{ if eq .scope_name \"sports_follow.web\" }}web app{{ else }}{{ trimPrefix \"sports-follow-\" .service_name }}{{ end }}` | unwrap observed_timestamp | __error__=\"\" [$__range]) by (from, error, place) / 1e6",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "max_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | label_format from=`{{ if eq .scope_name \"sports_follow.web\" }}web app{{ else }}{{ trimPrefix \"sports-follow-\" .service_name }}{{ end }}` | unwrap observed_timestamp | __error__=\"\" [$__range]) by (from, error, place) / 1e6",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No errors in this range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "from": 0,
              "error": 1,
              "place": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "from": "From",
              "error": "Error",
              "place": "Where",
              "Value #A": "Lines",
              "Value #B": "First seen",
              "Value #C": "Last seen"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last seen",
                "desc": true
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Errors, by where they're from",
      "description": "Each bar counts one interval of the chart (longer ones for a longer range).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (from) (count_over_time({service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | label_format from=`{{ if eq .scope_name \"sports_follow.web\" }}web app{{ else }}{{ trimPrefix \"sports-follow-\" .service_name }}{{ end }}` [$__auto]))",
          "legendFormat": "{{from}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No errors in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "id": 6
    },
    {
      "type": "logs",
      "title": "Error lines, newest first, with their stacks",
      "description": "Expand a line for its fields (error, place, the request id, the web app's page and build) and its trace (traceID).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"sports-follow-(api|worker)\"} | error != \"\" | line_format \"{{ __line__ }}\\n{{ .exception_stacktrace }}\"",
          "legendFormat": "",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 18
      },
      "id": 7
    }
  ]
}
