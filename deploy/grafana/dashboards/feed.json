{
  "uid": "sports-follow-feed",
  "title": "Sports Follow · Feed",
  "description": "The feed's pipeline (BHA-326): uploads read, matched to followed players, kept, judged, passed and served, by sport and stream; why candidates are lost; each sport's coverage; the judge's verdicts and errors; moment search yield; the YouTube budget.",
  "tags": [
    "sports-follow"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(?!.*(alert-state-history|usage)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(?!.*usage).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Sports Follow",
      "type": "dashboards",
      "tags": [
        "sports-follow"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Uploads read",
      "description": "Uploads new to us: a trusted channel's (each counted once, published in the last 30 days) and every result of a moment search.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(increase(sports_follow_feed_uploads_total{job=~\"sports-follow-(curator|api)\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "None in this range",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
