{
  "uid": "sports-follow-api",
  "title": "Sports Follow · API",
  "description": "What fans ask of the API: requests, errors and time taken by route, from each request's log line (logs.py, server.RequestLog).",
  "tags": [
    "sports-follow"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(?!.*(alert-state-history|usage)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Sports Follow",
      "type": "dashboards",
      "tags": [
        "sports-follow"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Requests",
      "description": "API requests in the time range (health checks and the web app's files aren't counted).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Server errors (5xx)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | status >= 500 [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Refused (4xx)",
      "description": "Not found, not allowed, too many: mostly fine, a jump is worth a look.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | status >= 400 | status < 500 [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Time taken, p95",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | unwrap duration_ms | __error__=\"\" [$__range]) by ()",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests, by route",
      "description": "Each bar counts one interval of the chart (longer ones for a longer range).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (route) (count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" [$__auto]))",
          "legendFormat": "{{route}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Time taken, p95 by route",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | unwrap duration_ms | __error__=\"\" [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Errors, by route and status",
      "description": "Each bar counts one interval of the chart (longer ones for a longer range).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (route, status) (count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | status >= 400 [$__auto]))",
          "legendFormat": "{{status}} {{route}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 14
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Requests by route over the range",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (route) (count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" [$__range]))",
          "legendFormat": "requests",
          "queryType": "instant",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.5, {service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | unwrap duration_ms | __error__=\"\" [$__range]) by (route)",
          "legendFormat": "p50 ms",
          "queryType": "instant",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | unwrap duration_ms | __error__=\"\" [$__range]) by (route)",
          "legendFormat": "p95 ms",
          "queryType": "instant",
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (route) (count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | status >= 500 [$__range]))",
          "legendFormat": "5xx",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "p50 (ms)",
              "Value #C": "p95 (ms)",
              "Value #D": "5xx"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95 (ms)",
                "desc": true
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "Failed requests",
      "description": "Each line opens its trace: expand it and follow traceID.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | status >= 400",
          "legendFormat": "",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "id": 9
    },
    {
      "type": "logs",
      "title": "API warnings and errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"sports-follow-api\"} | severity_text=~\"WARN|ERROR|FATAL\"",
          "legendFormat": "",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "id": 10
    }
  ]
}
