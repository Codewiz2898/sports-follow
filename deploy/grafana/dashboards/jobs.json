{
  "uid": "sports-follow-jobs",
  "title": "Sports Follow · Jobs and live polls",
  "description": "The worker: live games and how recently each was polled, the job queue, jobs (runs, failures, time in the queue, time taken), live poll rounds and cards; from the worker's metrics, each job's closing log line and the rounds' spans.",
  "tags": [
    "sports-follow"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(?!.*(alert-state-history|usage)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(?!.*(usage|ml-metrics)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Sports Follow",
      "type": "dashboards",
      "tags": [
        "sports-follow"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Live games now",
      "description": "Armed and live games with a followed player, polled by the worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(sports_follow_live_games{job=\"sports-follow-worker\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Games behind",
      "description": "Live games not polled for 3 minutes. Every game is polled at least once a minute.",
