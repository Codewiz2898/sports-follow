    {
      "type": "timeseries",
      "title": "Since each source's games were last polled, at the worst",
      "description": "Seconds since the least recently polled live game of each source was polled. Over 180 s, a game is behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
