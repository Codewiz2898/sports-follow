{
  "uid": "sports-follow-notifications",
  "title": "Sports Follow · Notifications",
  "description": "Moments found, and pushes to fans' devices: delivered, failed by push service, opened, and how long a moment waited for its push; from notify.py's log lines and metrics.",
  "tags": [
    "sports-follow"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(?!.*(alert-state-history|usage)).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(?!.*usage).*$/",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Sports Follow",
      "type": "dashboards",
      "tags": [
        "sports-follow"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Pushes delivered",
      "description": "Device pushes a push service took, in the range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | delivered != \"\" | unwrap delivered | __error__=\"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Pushes failed",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | push_service != \"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Opened",
      "description": "Notifications a fan opened, in the range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | route=\"/api/notifications/{notification_id}/opened\" | status < 300 [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Moment to push, p95",
      "description": "From a poll or a build finding a moment to its push going out.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | waited_ms != \"\" | unwrap waited_ms | __error__=\"\" [$__range]) by ()",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Pushes",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | delivered != \"\" | unwrap delivered | __error__=\"\" [$__auto]))",
          "legendFormat": "delivered",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | devices != \"\" | unwrap devices | __error__=\"\" [$__auto]))",
          "legendFormat": "devices tried",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"sports-follow-api\"} | scope_name=\"sports_follow.requests\" | route=\"/api/notifications/{notification_id}/opened\" | status < 300 [$__auto]))",
          "legendFormat": "opened",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Failed pushes, by push service and status",
      "description": "410 or 404: the device unsubscribed (its subscription is removed). 413: too big. 429: too many.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (push_service, status) (count_over_time({service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | push_service != \"\" [$__auto]))",
          "legendFormat": "{{push_service}} {{status}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Moment to push, p95",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\" | waited_ms != \"\" | unwrap waited_ms | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p95",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 14
      },
      "id": 7
    },
    {
      "type": "logs",
      "title": "Push lines",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"sports-follow.*\"} | scope_name=\"sports_follow.notify\"",
          "legendFormat": "",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Moments found, by kind",
      "description": "Goals, wickets, results… as polls and builds find them (notify.record).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (kind) (increase(sports_follow_moments_total{job=~\"sports-follow-(api|worker)\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "noValue": "No data in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 14
      },
      "id": 9
    },
    {
      "type": "text",
      "title": "Open rate by kind",
      "options": {
        "mode": "markdown",
        "content": "Pushes and opens by kind of moment (goal, wicket, result…) over the last week, on the server:\n\n`docker compose -f deploy/compose.yaml exec worker python -m sports_follow.notify stats 7`"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 3
      },
      "id": 10
    }
  ]
}
