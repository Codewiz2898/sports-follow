{
  "packageId": "io.github.codewiz2898.sportsfollow",
  "host": "sportsfollow.example",
  "name": "Sports Follow",
  "launcherName": "Sports Follow",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0B0E13",
  "themeColorDark": "#0B0E13",
  "navigationColor": "#0F131A",
  "navigationColorDark": "#0F131A",
  "navigationDividerColor": "#2A3340",
  "navigationDividerColorDark": "#2A3340",
  "backgroundColor": "#0B0E13",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "/icons/icon-512.png",
  "maskableIconUrl": "/icons/maskable-512.png",
  "monochromeIconUrl": "/icons/monochrome-512.png",
  "webManifestUrl": "/manifest.webmanifest",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "~/.config/sports-follow/android-upload.keystore", "alias": "upload" },
  "appVersionCode": 1,
  "appVersion": "0.1.0",
  "shortcuts": [
    { "name": "Search players", "shortName": "Search", "url": "/search", "chosenIconUrl": "/icons/icon-192.png" }
  ],
  "generatorApp": "sports-follow/android/generate.mjs",
  "fallbackType": "customtabs",
  "features": {},
  "enableSiteSettingsShortcut": true,
  "minSdkVersion": 23,
  "fingerprints": []
